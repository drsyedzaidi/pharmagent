   "conventions": {
    "approval_meaning": "Approved means the owner reviewed an entry as an accurate description of PharmAgent behaviour. For an implementation_convention it is not regulatory validation.",
    "catalog_version": "1.5.0",
    "conventions": [
     {
      "approval": "approved",
      "approved_by": "Syed Saoud Zaidi",
      "approved_on": "2026-10-21",
      "id": "nca.linear_up_log_down",
      "rule_text": "AUC is integrated with the linear-up/log-down trapezoidal rule: linear on rising or flat segments, logarithmic on declining positive segments.",
      "version": "1.0.0"
     },
     {
      "approval": "approved",
      "approved_by": "Syed Saoud Zaidi",
      "approved_on": "2026-10-21",
      "id": "nca.auc_last_ends_at_tlast",
      "rule_text": "AUC_last and AUMC_last end at Tlast, the last positive concentration. Zero or BLQ rows after it add no area, and AUC_inf extrapolates from Tlast once.",
      "version": "1.0.0"
     },
     {
      "approval": "approved",
      "approved_by": "Syed Saoud Zaidi",
      "approved_on": "2026-10-21",
      "id": "nca.pre_dose_records",
      "rule_text": "Single-dose records before the dose time add no area before the dose. With no usable record at the dose time, the closest pre-dose record sets C = 0 there only when it is BLQ-flagged or a measured 0; a positive pre-dose value is never carried to the dose time.",
      "version": "1.0.0"
     },
     {
      "approval": "approved",
      "approved_by": "Syed Saoud Zaidi",
      "approved_on": "2026-10-21",
      "id": "nca.lambda_z_window",
      "rule_text": "Lambda_z is fitted over contiguous windows of at least 3 positive concentrations after Tmax that always end at the last point, and the window with the largest adjusted R-squared is chosen. A window needs a decline steeper than 1e-09 per time unit (issue #12: this rejects floating-point noise on flat terminal phases) and a positive adjusted R-squared; otherwise no lambda_z is reported. Equal fits go to the longest window: a later, shorter window replaces the current best only when its adjusted R-squared is strictly greater than the stored best, rounded to 6 decimals.",
      "version": "1.1.0"
     }
    ]
   },
