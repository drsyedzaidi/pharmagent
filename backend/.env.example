# PharmAgent backend configuration (copy to .env). All vars are PHARMAGENT_*.
# The app runs fully without any of these — MockLLM (keyless, deterministic) is
# the default and the whole test suite is keyless.

# --- LLM (optional; MockLLM used when no key) ---
# PHARMAGENT_ANTHROPIC_API_KEY=sk-ant-...
# PHARMAGENT_MODEL=claude-opus-4-8
# PHARMAGENT_MAX_TOKENS=2048
# PHARMAGENT_USE_MOCK_LLM=false

# --- Storage ---
# PHARMAGENT_DATA_DIR=data
# PHARMAGENT_DB_PATH=pharmagent.db

# --- Auth (unset = open dev mode; set = bearer token required on all sessions) ---
# Authenticated deployments must also enable enforced audit sealing below.
# PHARMAGENT_API_TOKEN=change-me-to-a-long-random-secret

# --- Audit authenticity ---
# Default "off" is explicitly hash-only local development and is never reported
# by /audit as externally verified. "enforce" requires all three settings.
# Keep the anchor outside the primary DB writer's directory/credentials.
# Generate a key, for example:
#   python -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
# Retain old key IDs in the JSON when rotating; historical seals need them.
# PHARMAGENT_AUDIT_MODE=enforce
# PHARMAGENT_AUDIT_KEYS_JSON={"2026-07":"<base64-encoded-32+-byte-key>"}
# PHARMAGENT_AUDIT_ACTIVE_KEY_ID=2026-07
# PHARMAGENT_AUDIT_ANCHOR_PATH=/protected/pharmagent/audit-anchor.jsonl

# --- CORS: default ['*']; set to your UI origin(s) in production ---
# PHARMAGENT_CORS_ORIGINS=["https://app.example.com"]

# --- Branding ---
# PHARMAGENT_APP_NAME=PharmAgent
# PHARMAGENT_ORG_NAME=PmatricsAI
